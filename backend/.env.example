PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=./data/skillmatch.db

# Optional. Without it the app still runs: explanations and the chatbot
# fall back to deterministic templates instead of calling Claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Optional. Anthropic does not sell an embeddings model, so semantic
# matching uses Voyage AI when this key is present and a local hashing
# vectoriser when it is not.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
